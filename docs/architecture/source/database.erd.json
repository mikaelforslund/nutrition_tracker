  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership and RLS",
      "items": [
        "Every table references auth.users(id) with on delete cascade, so deleting a person removes all their rows.",
        "Tracking tables have select/insert/update/delete policies on user_id = auth.uid() for the authenticated role.",
        "device_sessions, session_groups, person_groups and app_settings have RLS on with no policies: server code only."
      ]
    },
    {
      "dot": "amber",
      "title": "Unique rules not drawn as keys",
      "items": [
        "weight_logs: one row per (user_id, logged_on); a second weigh-in replaces the first.",
        "drink_logs: one row per (user_id, drunk_on, drink_type); glasses count up and down.",
        "device_sessions: one row per (user_id, device_id); display_name and group name are unique case-insensitively."
      ]
    },
    {
      "dot": "emerald",
      "title": "Derived values",
      "items": [
        "food_logs.calories is generated: round(protein*4 + carbs*4 + fat*9).",
        "user_profiles.updated_at is set by a trigger and feeds the dashboard version fingerprint.",
        "app_settings keys: vision.provider, vision.base_url, vision.model, vision.api_key."
      ]
    }
  ]
}