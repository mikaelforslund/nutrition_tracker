  "cards": [
    {
      "dot": "cyan",
      "title": "Main journey",
      "items": [
        "A photo goes to POST /api/vision/analyze; the model's macros come back as an editable draft.",
        "saveFoodLog stores the meal; Postgres computes calories from the macros.",
        "Open pages poll /api/dashboard/version every 3 s and refresh when it changes."
      ]
    },
    {
      "dot": "rose",
      "title": "Two auth modes",
      "items": [
        "AUTH_MODE=mock: a person picks a name; the m-session cookie maps to device_sessions.",
        "AUTH_MODE=supabase: email code sign-in; the proxy refreshes the JWT cookies.",
        "Sessions, groups, settings and the database viewer's admin view exist only in mock mode."
      ]
    },
    {
      "dot": "emerald",
      "title": "Data rules",
      "items": [
        "withUser sets the JWT claims and the authenticated role, so row level security applies.",
        "Server-only tables (sessions, groups, app_settings) have RLS with no policies.",
        "Vision settings saved on the Settings page override the VISION_* environment."
      ]
    }
  ]
