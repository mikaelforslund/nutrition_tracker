  "cards": [
    {
      "dot": "rose",
      "title": "Failure exits",
      "items": [
        "No acting user: 401 UNAUTHENTICATED. Wrong type: 415. Over 8 MB: 413. No Content-Length: 411.",
        "isFood false or undecodable image: 422 IMAGE_NOT_RECOGNIZED, 'That photo doesn't look like food.'",
        "Any other provider error: 502 INFERENCE_FAILED. Cancel aborts the request and nothing is stored."
      ]
    },
    {
      "dot": "cyan",
      "title": "Trust boundaries",
      "items": [
        "The model's output is parsed against the zod contract before it is returned.",
        "Calories are never taken from the model or the person: both the server and Postgres compute them.",
        "The photo is stored only after a successful analysis, under the acting user's id."
      ]
    },
    {
      "dot": "emerald",
      "title": "Variants",
      "items": [
        "Manual entry skips analysis: per-serving macros x quantity go straight to saveFoodLog.",
        "VISION_PROVIDER=mock returns one of six canned plates picked by the image's SHA-256.",
        "A JSON body with an https imageUrl on VISION_ALLOWED_IMAGE_HOSTS skips the upload step."
      ]
    }
  ]
