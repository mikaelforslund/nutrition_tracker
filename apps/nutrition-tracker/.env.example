# Copy to .env.local for `pnpm dev`. The compose stack sets its own values.

# --- Database ---------------------------------------------------------------
# Local compose database. For Supabase, use the transaction pooler string from
# Project Settings > Database (port 6543).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=5

# --- Auth -------------------------------------------------------------------
# mock: every request is MOCK_USER_ID. Refused in production builds unless
#       ALLOW_MOCK_AUTH=true.
# supabase: requests must carry a valid Supabase access token.
AUTH_MODE=mock
MOCK_USER_ID=00000000-0000-4000-8000-000000000001
ALLOW_MOCK_AUTH=false

# Required when AUTH_MODE=supabase or STORAGE_DRIVER=supabase.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# Only for projects on the legacy shared secret. Otherwise tokens are verified
# against the project's JWKS endpoint.
# SUPABASE_JWT_SECRET=

# --- Object storage ---------------------------------------------------------
# local: files on disk under UPLOAD_DIR.
# supabase: a private Supabase Storage bucket.
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
# STORAGE_BUCKET=nutrition-uploads
# SUPABASE_SERVICE_ROLE_KEY=

# --- Developer tools -------------------------------------------------------
# Dashboard panel for browsing and editing your own rows. Keep off in production.
ENABLE_DB_VIEWER=true

# --- Vision -----------------------------------------------------------------
# openai: any OpenAI-compatible server, such as Ollama or vLLM.
# mock: canned answers that ignore the image.
VISION_PROVIDER=openai
VISION_BASE_URL=http://localhost:11434/v1
VISION_MODEL=qwen3.5:9b
# VISION_API_KEY=
VISION_TIMEOUT_MS=120000
# Longest edge sent to the model. Larger is much slower and wasn't more accurate.
VISION_MAX_IMAGE_PX=512
MOCK_VISION_LATENCY_MS=1000
# Comma-separated hosts that /api/vision/analyze accepts as https image URLs.
VISION_ALLOWED_IMAGE_HOSTS=
